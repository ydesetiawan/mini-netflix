# Server
APP_PORT=8080
APP_ENV=development

# PostgreSQL (local — not in Docker)
# Use localhost when running the app directly on your machine
# Use host.docker.internal if running the app inside a container
DB_HOST=localhost
DB_PORT=5432
DB_USER=netflix
DB_PASSWORD=netflix123
DB_NAME=mini_netflix
DB_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Elasticsearch
ES_URL=http://localhost:9200
ES_INDEX_CONTENT=content

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mini-netflix
MINIO_USE_SSL=false

# CDN
CDN_BASE_URL=http://localhost:9000/mini-netflix

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRY_HOURS=72
